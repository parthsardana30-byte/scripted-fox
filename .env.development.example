# Local development only. Copy to .env.development.local and fill in secrets.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Local PostgreSQL and authentication
DATABASE_URL=postgresql://scriptedfox:change-me@localhost:5432/scriptedfox
BETTER_AUTH_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development Google OAuth client for Connect YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=

# Gemini primary, Grok fallback
AI_PROVIDER=gemini,grok
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROK_API_KEY=
GROK_MODEL=

# Optional legacy Groq fallback
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# PayU subscriptions (keep server-only; leave blank until prices are finalized)
BILLING_TEST_USER_IDS=
BILLING_PROVIDER=payu
PAYU_ENVIRONMENT=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
