# Local development only. Copy to .env.development.local and fill in secrets.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Supabase-hosted PostgreSQL (Database > Connect > Session pooler).
# Keep `sslmode=require`; do not use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Better Auth runs inside this app. Generate a unique local development secret
# with at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET=

# Google OAuth client used only for application sign-in.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Email verification codes. A verified Resend sender is required.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Scripted Fox <verify@your-domain.com>

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development Google OAuth client for Connect YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=
CRON_SECRET=

# Gemini primary, Grok fallback
AI_PROVIDER=gemini,grok
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROK_API_KEY=
GROK_MODEL=

# Optional legacy Groq fallback
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# PayU live checkout (keep credentials server-only)
# Fox AI support assistant (OpenAI-compatible chat-completions endpoint).
FOX_AI_API_URL=
FOX_AI_API_KEY=
FOX_AI_MODEL=
FOX_AI_SUPPORT_EMAIL=

# PayU subscriptions (keep server-only; leave blank until prices are finalized)
BILLING_TEST_USER_IDS=
BILLING_PROVIDER=payu
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
