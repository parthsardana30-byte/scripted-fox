# Template only. Put these values in the production hosting platform,
# not in a committed .env.production file.
NEXT_PUBLIC_DEPLOYMENT_ENV=production

# Private PostgreSQL service on the VPS
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://scriptedfox:the-same-password@postgres:5432/scriptedfox
BETTER_AUTH_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

NEXT_PUBLIC_SITE_URL=https://app.your-company.com

# Company-owned Google OAuth client for Connect YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=https://app.your-company.com/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=

AI_PROVIDER=gemini,grok
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROK_API_KEY=
GROK_MODEL=
AI_API_KEY=
AI_MODEL=

# PayU subscriptions (server-only values from the production PayU dashboard)
BILLING_TEST_USER_IDS=
BILLING_PROVIDER=payu
PAYU_ENVIRONMENT=production
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
