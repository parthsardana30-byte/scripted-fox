# Template only. Put these values in the production hosting platform,
# not in a committed .env.production file.
NEXT_PUBLIC_DEPLOYMENT_ENV=production

# Production Supabase-hosted PostgreSQL. Use a production-only project and the
# Session pooler URL from Database > Connect; keep TLS required.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Unique production secret for Better Auth. Never reuse a development value.
BETTER_AUTH_SECRET=

# Company-owned Google OAuth client used only for application sign-in.
# Authorized redirect URI: https://app.your-company.com/api/auth/callback/google
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Production transactional email (server-only)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Scripted Fox <verify@your-domain.com>

NEXT_PUBLIC_SITE_URL=https://app.your-company.com

# Company-owned Google OAuth client for Connect YouTube. This is intentionally a
# separate client because the YouTube scopes require their own Google review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=https://app.your-company.com/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=
CRON_SECRET=

AI_PROVIDER=gemini,grok
GEMINI_API_KEY=
THUMBNAIL_API_KEY=
THUMBNAIL_MODEL=gemini-2.5-flash-image
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROK_API_KEY=
GROK_MODEL=
AI_API_KEY=
AI_MODEL=

# Fox AI support assistant. Keep the key server-side.
FOX_AI_API_URL=
FOX_AI_API_KEY=
FOX_AI_MODEL=
FOX_AI_SUPPORT_EMAIL=

# PayU subscriptions (server-only values from the production PayU dashboard)
BILLING_PROVIDER=payu
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
