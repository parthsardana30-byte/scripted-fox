# Copy this file to .env.development.local for local development.
# In production, set the same variable names in the hosting platform.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Supabase-hosted PostgreSQL. Use the Session pooler URL shown under
# Database > Connect and retain `sslmode=require`.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Better Auth runs in this Next.js server; this is not a Supabase Auth secret.
BETTER_AUTH_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Email verification codes (server-only). Verify AUTH_EMAIL_FROM in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Scripted Fox <verify@your-domain.com>

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud OAuth — only for the separate "Connect YouTube" flow.
# Google account sign-in uses the credentials above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=
# Protects the scheduled trend refresh endpoint. Schedule one daily GET to
# /api/cron/trends with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# AI providers — Gemini first, Grok fallback. Keep keys server-side only.
AI_PROVIDER=gemini,grok
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROK_API_KEY=
GROK_MODEL=

# Legacy Groq-compatible configuration (optional fallback).
AI_API_KEY=
AI_MODEL=

# Comma-separated user IDs allowed to switch plans without payments.
BILLING_TEST_USER_IDS=
GOOGLE_SITE_VERIFICATION=
