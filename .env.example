# Copy this file to .env.development.local for local development.
# In production, set the same variable names in the hosting platform.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Public Supabase settings — use a separate Supabase project per environment
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings — never expose these in browser code
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud OAuth — only for the separate "Connect YouTube" flow.
# Google account sign-in credentials belong in Supabase Auth, not this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_DATA_API_KEY=

# AI provider — optional until we implement AI generation
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
